# --- Obrigatorias ---
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=

# --- Agendamento ---
POST_TIME=08:00              # HH:MM, 24h
TIMEZONE=America/Fortaleza

# --- Comportamento ---
MAX_ARTICLES=12              # maximo de noticias no fallback RSS
MAX_AGE_HOURS=24             # janela de coleta RSS (horas)
DB_PATH=data/sent.db
LOG_LEVEL=INFO

# --- Curadoria com IA (Gemini) ---
AI_MODE=candidates           # candidates | auto | grounded | off
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TOP_N=12                  # n total de noticias desejado (1 a 20, agrupadas por categoria)
AI_MIN_ITEMS=4               # abaixo disso, completa com RSS
AI_MAX_CANDIDATES=50         # maximo de candidatos enviados no Modo B
ALREADY_SENT_DAYS=3          # janela de titulos enviados passada ao modelo
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=3
AI_MAX_AGE_HOURS=48          # validacao: descarta item com published_at mais antigo que isso
MANUAL_COOLDOWN_MINUTES=60   # cooldown do /noticias com forcar=true

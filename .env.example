# --- Obrigatorias ---
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=

# --- Agendamento ---
# Formato HH:MM (24h)
POST_TIME=08:00
TIMEZONE=America/Fortaleza

# --- Comportamento ---
# Maximo de noticias no fallback RSS
MAX_ARTICLES=12
# Janela de coleta RSS (horas)
MAX_AGE_HOURS=24
DB_PATH=data/sent.db
LOG_LEVEL=INFO

# --- Curadoria com IA (Gemini) ---
# Opcoes: candidates | auto | grounded | off
AI_MODE=candidates
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Total de noticias desejado (1 a 20, agrupadas por categoria)
AI_TOP_N=12
# Abaixo disso, completa com RSS
AI_MIN_ITEMS=4
# Maximo de candidatos enviados no Modo B
AI_MAX_CANDIDATES=50
# Janela de titulos enviados passada ao modelo
ALREADY_SENT_DAYS=3
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=3
# Validacao: descarta item com published_at mais antigo que isso
AI_MAX_AGE_HOURS=48
# Cooldown do /noticias com forcar=true (minutos)
MANUAL_COOLDOWN_MINUTES=60
